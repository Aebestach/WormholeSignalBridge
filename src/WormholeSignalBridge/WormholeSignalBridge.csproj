<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>2.0.0</Version>
    <FileVersion>$(Version)</FileVersion>
    <AssemblyName>WormholeSignalBridge</AssemblyName>
    <RootNamespace>WormholeSignalBridge</RootNamespace>
    <TargetFramework>net481</TargetFramework>

    <Description>Routes RealAntennas comm links through KEX wormholes.</Description>
    <Product>WormholeSignalBridge</Product>

    <KSPBT_ModRoot>$(ProjectRootDir)GameData\$(AssemblyName)</KSPBT_ModRoot>
    <KSPBT_ModPluginFolder>Plugins</KSPBT_ModPluginFolder>

    <LangVersion>latest</LangVersion>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(KSPBT_ModVersion)' != '' ">
    <Version>$(KSPBT_ModVersion)</Version>
    <FileVersion>$(Version)</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="KSPBuildTools" Version="1.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ModReference Include="RealAntennas">
      <DLLPath>GameData/RealAntennas/Plugins/RealAntennas.dll</DLLPath>
      <KSPAssemblyVersion>2.0</KSPAssemblyVersion>
    </ModReference>
    <ModReference Include="KEX-Wormholes">
      <DLLPath>GameData/KopernicusExpansion/Plugins/KEX-Wormholes.dll</DLLPath>
      <KSPAssemblyName>KopernicusExpansion.Wormholes</KSPAssemblyName>
      <KSPAssemblyVersion>1.0</KSPAssemblyVersion>
    </ModReference>
  </ItemGroup>

  <ItemGroup>
    <KSPVersionFile Include=".">
      <Destination>$(KSPBT_ModRoot)/$(AssemblyName).version</Destination>
      <URL>https://github.com/Aebestach/WormholeSignalBridge/releases/latest/download/WormholeSignalBridge.version</URL>
      <Download>https://github.com/Aebestach/WormholeSignalBridge/releases/latest</Download>
      <KSP_Version>1.12.5</KSP_Version>
      <KSP_Version_Min>1.12.0</KSP_Version_Min>
      <KSP_Version_Max>1.12.99</KSP_Version_Max>
    </KSPVersionFile>
  </ItemGroup>

  <Target Name="DeployGameDataToKsp" AfterTargets="KSPBT_CopyDLLsToPluginFolder" Condition=" '$(KSPBT_GameRoot)' != '' ">
    <PropertyGroup>
      <_KspModDeployDir>$(KSPBT_GameRoot)/GameData/$(AssemblyName)</_KspModDeployDir>
    </PropertyGroup>
    <ItemGroup>
      <_ModDeployFiles Include="$(KSPBT_ModRoot)/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_ModDeployFiles)" DestinationFolder="$(_KspModDeployDir)/%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Message Text="Deployed GameData to $(_KspModDeployDir)" Importance="high" />
  </Target>
</Project>
